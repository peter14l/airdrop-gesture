<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="windows_app.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:windows_app"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
            <TextBlock Text="AirDrop Gesture Desktop Service" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" />
            <TextBlock Text="Status: Active and Listening on ws://0.0.0.0:8080" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Left Side: Status & Log Panel -->
        <Grid Grid.Row="1" Grid.Column="0" RowSpacing="16" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status Details -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Zero-Config Auto-Pairing Active" FontWeight="SemiBold" />
                    <TextBlock Text="Discovery service broadcasts local IP via mDNS. Connect from the Android app to synchronize clipboards instantly." TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Content="Open AirDrop Downloads Folder" Click="OpenFolderButton_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Log Panel -->
            <Grid Grid.Row="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Activity Logs" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" FontFamily="Consolas" Padding="8" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Right Side: Camera Preview / Gesture State -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Camera Selector -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Webcam Source:" FontSize="12" FontWeight="SemiBold" />
                <ComboBox x:Name="CameraSelectorComboBox" HorizontalAlignment="Stretch" SelectionChanged="CameraSelectorComboBox_SelectionChanged" PlaceholderText="Select Webcam" />
            </StackPanel>

            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Padding="8">
                <Grid>
                    <!-- Fallback camera icon/text -->
                    <StackPanel x:Name="CameraFallbackPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                        <SymbolIcon Symbol="Video" Width="36" Height="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Camera Loading..." Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                    
                    <!-- Real Camera Frame Source -->
                    <Image x:Name="CameraPreviewImage" Stretch="Uniform" />
                </Grid>
            </Border>

            <!-- Gesture Alert Badge -->
            <Border Grid.Row="2" x:Name="GestureStatusBadge" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" CornerRadius="8" Padding="16">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Laptop Gesture Tracker" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GestureStatusText" Text="Waiting for drop gesture..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
